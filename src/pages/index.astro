---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { Image } from "astro:assets";
import profile from "../assets/headshot.png";
import resume from "../assets/Kenny_Sun_Resume.pdf";
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500&display=swap" rel="stylesheet" />

		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main class="page">
			<section class="about-split">
				<div class="about-left">
					<Image
						 src={profile}
						 alt="Photo of Kenny Sun"
						 class="profile-photo"
						 loading="lazy"
						/>
				</div>

				<div class="about-right">
					<h1 class="about-name">Kenny Sun</h1>

					<p class="about-details">
						Hello! I'm Kenny Sun, a Senior Computer Science major and Business
						Administration minor at Clemson University graduating in December 2026!
					</p>

					<p class="about-details">
						Welcome to my personal website. This website serves as
						a dual purpose career and lifestyle website. I'll be posting
						projects I'm working on, my favorite recipes, and any other thoughts I have!
					</p>

					<div class="contact-row">
						<a class="contact-link" href="mailto:sunkenny5893@gmail.com">sunkenny5893@gmail.com</a>
						<a class="contact-link" href="https://www.linkedin.com/in/kenny-sun1/" target="_blank" rel="noreferrer">LinkedIn</a>
						<a class="contact-link" href="https://github.com/mystica-l" target="_blank" rel="noreferrer">GitHub</a>
						<a class="contact-link" href={resume} target="_blank" rel="noreferrer">Resume</a>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	/* Page + base */
	html,
	body {
		height: 90%;
	}

	.page {
		width: 90%;
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem;
	}

	p,
	a {
		font-family: Kanit, Arial;
		margin-top: 0;
		margin-bottom: 0;
	}

	/* Layout */
	.about-split {
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	.about-left {
		display: flex;
		justify-content: center;
		flex: 0 0 30%;
	}

	.profile-photo {
		width: clamp(140px, 30vw, 320px);
		aspect-ratio: 1 / 1;
		object-fit: cover;
		filter: brightness(1.05);
		border-radius: 18px;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
	}

	.about-right {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		flex: 1;
		min-width: 0; /* prevents overflow on narrow screens */
	}

	.about-name {
		font-family: Kanit, Arial;
		font-weight: 500;
		font-size: clamp(2rem, 4vw, 3rem);
		margin: 0;
	}

	.about-details {
		font-size: clamp(1.05rem, 1.6vw, 1.15rem);
		line-height: 1.5;
		opacity: 0.9;
	}

	/* Contact pills */
	.contact-row {
		margin-top: 0.5rem;
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		align-items: center;
	}

	.contact-link {
		background-color: lightgrey;
		color: rgb(var(--gray-dark));
		padding: 0.5rem 1rem;
		border-radius: 12px;
		font-family: Kanit, Arial;
		text-decoration: none;
		border-bottom: 1px solid rgba(0, 0, 0, 0.25);
		max-width: 100%;
	}

	.contact-link:hover {
		border-bottom-color: rgba(0, 0, 0, 0.6);
	}

	/* Small screens */
	@media (max-width: 720px) {
		.page {
			padding: 1.25rem;
		}

		.about-split {
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: 1.25rem;
			margin: 0;
		}

		.about-left {
			flex: none;
			width: 100%;
		}

		.profile-photo {
			width: min(70vw, 320px);
		}

		.about-right {
			width: 100%;
			align-items: center;
		}

		/* prevent long email from breaking layout */
		.contact-row {
			justify-content: center;
		}

		.contact-link {
			display: inline-flex;
			max-width: 100%;
			word-break: break-word;
			overflow-wrap: anywhere;
		}
	}

	/* Very small screens: make contact links full width for readability */
	@media (max-width: 420px) {
		.contact-link {
			width: 100%;
			justify-content: center;
		}
	}
</style>
