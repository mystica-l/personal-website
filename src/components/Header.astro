<div class="menu-backdrop" aria-hidden="true"></div>
<script>
	const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
	const closeButton = document.querySelector<HTMLButtonElement>('.menu-close');
	const menu = document.querySelector<HTMLElement>('#mobile-menu');
	const backdrop = document.querySelector<HTMLElement>('.menu-backdrop');

	const setMenuState = (isOpen: boolean) => {
		toggle?.setAttribute('aria-expanded', String(isOpen));
		toggle?.querySelector('.sr-only')?.replaceChildren(document.createTextNode(isOpen ? 'Close navigation' : 'Open navigation'));
		menu?.classList.toggle('is-open', isOpen);
		backdrop?.classList.toggle('is-visible', isOpen);
		document.body.classList.toggle('menu-open', isOpen);
	};

	toggle?.addEventListener('click', () => setMenuState(toggle.getAttribute('aria-expanded') !== 'true'));
	closeButton?.addEventListener('click', () => setMenuState(false));
	backdrop?.addEventListener('click', () => setMenuState(false));
	menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuState(false)));
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') setMenuState(false);
	});
</script>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.internal-links {
		display: flex;
		align-items: center;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.menu-toggle,
	.menu-close,
	.menu-backdrop {
		display: none;
	}
	@media (max-width: 720px) {
		header {
			position: relative;
			z-index: 20;
		}
		nav {
			min-height: 4.25rem;
		}
		h2 {
			font-size: 0.95em;
			white-space: nowrap;
		}
		.menu-toggle {
			display: flex;
			flex-direction: column;
			justify-content: center;
			gap: 5px;
			width: 2.75rem;
			height: 2.75rem;
			margin-left: auto;
			padding: 0.5rem;
			color: var(--black);
			background: transparent;
			border: 0;
			cursor: pointer;
		}
		.menu-toggle span:not(.sr-only) {
			display: block;
			width: 100%;
			height: 2px;
			background: currentColor;
			transition: transform 180ms ease, opacity 180ms ease;
		}
		.menu-toggle[aria-expanded='true'] span:nth-last-child(3) {
			transform: translateY(7px) rotate(45deg);
		}
		.menu-toggle[aria-expanded='true'] span:nth-last-child(2) {
			opacity: 0;
		}
		.menu-toggle[aria-expanded='true'] span:last-child {
			transform: translateY(-7px) rotate(-45deg);
		}
		.internal-links {
			position: fixed;
			top: 0;
			right: 0;
			z-index: 30;
			flex-direction: column;
			align-items: stretch;
			width: min(18rem, 82vw);
			height: 100dvh;
			padding: 5.5rem 1.5rem 2rem;
			background: white;
			box-shadow: -8px 0 24px rgba(var(--black), 12%);
			transform: translateX(100%);
			transition: transform 220ms ease;
		}
		.internal-links.is-open {
			transform: translateX(0);
		}
		.menu-close {
			position: absolute;
			top: 1rem;
			right: 1rem;
			display: flex;
			align-items: center;
			justify-content: center;
			width: 2.75rem;
			height: 2.75rem;
			padding: 0.5rem;
			color: var(--black);
			background: transparent;
			border: 0;
			cursor: pointer;
		}
		.menu-close span:not(.sr-only) {
			position: absolute;
			width: 1.5rem;
			height: 2px;
			background: currentColor;
		}
		.menu-close span:nth-last-child(2) {
			transform: rotate(45deg);
		}
		.menu-close span:last-child {
			transform: rotate(-45deg);
		}
		.internal-links a {
			padding: 0.8rem 0;
			border-bottom: 1px solid rgb(var(--gray-light));
		}
		.menu-backdrop {
			position: fixed;
			inset: 0;
			z-index: 10;
			background: rgba(var(--black), 35%);
			opacity: 0;
			pointer-events: none;
			transition: opacity 220ms ease;
		}
		.menu-backdrop.is-visible {
			display: block;
			opacity: 1;
			pointer-events: auto;
		}
		body.menu-open {
			overflow: hidden;
		}
		.social-links {
			display: none;
		}
	}
</style>
